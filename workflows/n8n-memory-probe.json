      "id": "9ff8cbb7-8cbc-4f05-af09-1211215d0509",
      "name": "When chat message received"
    },
    {
      "parameters": {
        "mode": "load",
        "simplifyOutput": true,
        "options": {
          "groupMessages": true
        }
      },
      "type": "@n8n/n8n-nodes-langchain.memoryManager",
      "typeVersion": 1.1,
      "position": [
        240,
        0
      ],
      "id": "18f65278-dc53-4fd2-a580-af9c87db69ce",
      "name": "Load prior session messages",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const trigger = $('When chat message received').first().json;\nconst chatInput = typeof trigger.chatInput === 'string' ? trigger.chatInput : '';\nconst sessionId = typeof trigger.sessionId === 'string' ? trigger.sessionId : '';\nconst loadedItems = $input.all().map((item) => item.json);\n\nconst visible = [];\nfor (const item of loadedItems) {\n  if (!Array.isArray(item.messages)) continue;\n  for (const message of item.messages) {\n    if (typeof message.human === 'string') {\n      visible.push({ sender: 'human', text: message.human });\n    }\n    if (typeof message.ai === 'string') {\n      visible.push({ sender: 'ai', text: message.ai });\n    }\n    if (message.human === undefined && message.ai === undefined) {\n      const sender = message.sender ?? message.type ?? message.role ?? 'unknown';\n      const text = message.text ?? message.message ?? message.content ?? '';\n      visible.push({ sender, text });\n    }\n  }\n}\n\nconst interactionCount = loadedItems.reduce((total, item) => {\n  return total + (Number.isInteger(item.messagesCount) ? item.messagesCount : 0);\n}, 0);\nconst output = `Memory probe loaded ${interactionCount} prior interaction(s) containing ${visible.length} visible message(s). Current message: ${chatInput}`;\n\nreturn [{\n  json: {\n    status: 'success',\n    output,\n    sessionId,\n    chatInput,\n    priorInteractionCount: interactionCount,\n    loadedHistory: visible,\n    rawLoadOutput: loadedItems\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "id": "0344c335-b8c1-4a8f-895a-7b7f5e508521",
      "name": "Build probe reply"
    },
    {
      "parameters": {
        "mode": "insert",
        "insertMode": "insert",
        "messages": {
          "messageValues": [
            {
              "type": "user",
              "message": "={{ $('Build probe reply').first().json.chatInput }}",
              "hideFromUI": false
            },
            {
              "type": "ai",
              "message": "={{ $('Build probe reply').first().json.output }}",
              "hideFromUI": false
            }
          ]
        }
      },
      "type": "@n8n/n8n-nodes-langchain.memoryManager",
      "typeVersion": 1.1,
      "position": [
        720,
        0
      ],
      "id": "f5bbdc84-dbc8-48ed-8eb1-765039382d4a",
      "name": "Insert visible turn"
    },
    {
      "parameters": {
        "jsCode": "const prepared = $('Build probe reply').first().json;\nreturn [{\n  json: {\n    ...prepared,\n    memoryInsertOutput: $input.all().map((item) => item.json)\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
